{
  "compilerOptions": {
    "types": ["vitest/importMeta"],
    "target": "es2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
